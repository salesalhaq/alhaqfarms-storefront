{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alhaqfarms-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "shop.alhaqfarms.com.pk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "alhaqfarms-storefront"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://shop.alhaqfarms.com.pk",
    "NEXT_PUBLIC_SUPABASE_URL": "https://osrzfwdeyznfvduizmgs.supabase.co",
